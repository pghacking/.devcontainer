{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Attach Debug",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "program": "${workspaceFolder}/Debug/install/bin/postgres",
            "additionalSOLibSearchPath": "${workspaceFolder}/Debug/install/lib",
            "setupCommands": [
                {
                    "text": "handle SIGUSR1 noprint nostop pass",
                    "description": "let gdb not stop when SIGUSR1 is sent to process",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Attach Debug Optimized",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "program": "${workspaceFolder}/Release/install/bin/postgres",
            "additionalSOLibSearchPath": "${workspaceFolder}/Release/install/lib",
            "setupCommands": [
                {
                    "text": "handle SIGUSR1 noprint nostop pass",
                    "description": "let gdb not stop when SIGUSR1 is sent to process",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(lldb) Attach Debug",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}",
            "program": "${workspaceFolder}/Debug/install/bin/postgres",
            "preRunCommands": [
                "settings append target.exec-search-paths ${workspaceFolder}/Debug/install/lib",
                "process handle SIGUSR1 -n false -s false -p true"
            ]
        },
        {
            "name": "(lldb) Attach Debug Optimized",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}",
            "program": "${workspaceFolder}/Release/install/bin/postgres",
            "preRunCommands": [
                "settings append target.exec-search-paths ${workspaceFolder}/Release/install/lib",
                "process handle SIGUSR1 -n false -s false -p true"
            ]
        }
    ]
}
