{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    // See PostgreSQL meson doc link https://wiki.postgresql.org/wiki/Meson
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        // Debug
        {
            "label": "meson setup Debug",
            "type": "process",
            "command": "meson",
            "args": [
                "setup",
                "${workspaceFolder}/Debug",
                "--prefix=${workspaceFolder}/Debug/install",
                "--buildtype=debug",    // default is debugoptimized
                "-Duuid=ossp",
                "-Dicu=enabled",
                "-Dc_args=-fno-inline-functions -fno-omit-frame-pointer -DCOPY_PARSE_PLAN_TREES -DWRITE_READ_PARSE_PLAN_TREES -DRAW_EXPRESSION_COVERAGE_TEST -DENFORCE_REGRESSION_TEST_NAME_RESTRICTIONS",
                "-Dcassert=true",
                "-Dtap_tests=enabled",
                "--werror"
            ],
            "problemMatcher": [],
            "detail": "meson setup debug configuration"
        },
        {
            "label": "ninja build Debug",
            "type": "process",
            "command": "ninja",
            "args": [
                "-C",
                "${workspaceFolder}/Debug",
                "-j",
                "4"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "build debug postgres"
        },
        {
            "label": "build document Debug",
            "type": "process",
            "command": "ninja",
            "args": [
                "-C",
                "${workspaceFolder}/Debug",
                "html"
            ],
            "problemMatcher": [],
            "detail": "build html document"
        },
        {
            "label": "regression tests Debug",
            "type": "process",
            "command": "meson",
            "args": [
                "test",
                "-C",
                "${workspaceFolder}/Debug",
                "-q",
                "--print-errorlogs",
                "--suite",
                "setup",
                "--suite",
                "regress"
            ],
            "problemMatcher": [],
            "detail": "run main regression tests"
        },
        {
            "label": "check-world Debug",
            "type": "process",
            "command": "meson",
            "args": [
                "test",
                "-C",
                "${workspaceFolder}/Debug",
                "-q",
                "--print-errorlogs"
            ],
            "problemMatcher": [],
            "detail": "run all tests"
        },
        {
            "label": "ninja install Debug",
            "type": "process",
            "command": "ninja",
            "args": [
                "-C",
                "${workspaceFolder}/Debug",
                "install"
            ],
            "problemMatcher": [],
            "detail": "install debug pgsql"
        },
        {
            "label": "init cluster Debug",
            "type": "process",
            "command": "${workspaceFolder}/Debug/install/bin/initdb",
            "args": [
                "-D",
                "${workspaceFolder}/Debug/data"
            ],
            "problemMatcher": [],
            "detail": "init cluster using initdb"
        },
        {
            "label": "start cluster Debug",
            "type": "process",
            "command": "${workspaceFolder}/Debug/install/bin/pg_ctl",
            "args": [
                "-D",
                "${workspaceFolder}/Debug/data",
                "-l",
                "${workspaceFolder}/Debug/postgres.log",
                "start"
            ],
            "problemMatcher": [],
            "detail": "start db cluster"
        },
        {
            "label": "restart cluster Debug",
            "type": "process",
            "command": "${workspaceFolder}/Debug/install/bin/pg_ctl",
            "args": [
                "-D",
                "${workspaceFolder}/Debug/data",
                "-l",
                "${workspaceFolder}/Debug/postgres.log",
                "restart"
            ],
            "problemMatcher": [],
            "detail": "restart db cluster"
        },
        {
            "label": "stop cluster Debug",
            "type": "process",
            "command": "${workspaceFolder}/Debug/install/bin/pg_ctl",
            "args": [
                "-D",
                "${workspaceFolder}/Debug/data",
                "stop"
            ],
            "problemMatcher": [],
            "detail": "stop debug db cluster"
        },

        // Release (optimized with debug information for profiling)
        {
            "label": "meson setup Release",
            "type": "process",
            "command": "meson",
            "args": [
                "setup",
                "${workspaceFolder}/Release",
                "--prefix=${workspaceFolder}/Release/install",
                "--buildtype=debugoptimized",
                "-Duuid=ossp",
                "-Dicu=enabled",
                "-Dc_args=-fno-omit-frame-pointer"
            ],
            "problemMatcher": [],
            "detail": "meson setup debug-optimized configuration"
        },
        {
            "label": "ninja build Release",
            "type": "process",
            "command": "ninja",
            "args": [
                "-C",
                "${workspaceFolder}/Release",
                "-j",
                "4"
            ],
            "problemMatcher": [],
            "detail": "build debug-optimized postgres"
        },
        {
            "label": "regression tests Release",
            "type": "process",
            "command": "meson",
            "args": [
                "test",
                "-C",
                "${workspaceFolder}/Release",
                "-q",
                "--print-errorlogs",
                "--suite",
                "setup",
                "--suite",
                "regress"
            ],
            "problemMatcher": [],
            "detail": "run main regression tests with the release build"
        },
        {
            "label": "check-world Release",
            "type": "process",
            "command": "meson",
            "args": [
                "test",
                "-C",
                "${workspaceFolder}/Release",
                "-q",
                "--print-errorlogs"
            ],
            "problemMatcher": [],
            "detail": "run all tests with the release build"
        },
        {
            "label": "ninja install Release",
            "type": "process",
            "command": "ninja",
            "args": [
                "-C",
                "${workspaceFolder}/Release",
                "install"
            ],
            "problemMatcher": [],
            "detail": "install debug-optimized pgsql"
        },
        {
            "label": "init cluster Release",
            "type": "process",
            "command": "${workspaceFolder}/Release/install/bin/initdb",
            "args": [
                "-D",
                "${workspaceFolder}/Release/data"
            ],
            "problemMatcher": [],
            "detail": "init release db cluster using initdb"
        },
        {
            "label": "start cluster Release",
            "type": "process",
            "command": "${workspaceFolder}/Release/install/bin/pg_ctl",
            "args": [
                "-D",
                "${workspaceFolder}/Release/data",
                "-l",
                "${workspaceFolder}/Release/postgres.log",
                "start"
            ],
            "problemMatcher": [],
            "detail": "start release db cluster"
        },
        {
            "label": "restart cluster Release",
            "type": "process",
            "command": "${workspaceFolder}/Release/install/bin/pg_ctl",
            "args": [
                "-D",
                "${workspaceFolder}/Release/data",
                "-l",
                "${workspaceFolder}/Release/postgres.log",
                "restart"
            ],
            "problemMatcher": [],
            "detail": "restart release db cluster"
        },
        {
            "label": "stop cluster Release",
            "type": "process",
            "command": "${workspaceFolder}/Release/install/bin/pg_ctl",
            "args": [
                "-D",
                "${workspaceFolder}/Release/data",
                "stop"
            ],
            "problemMatcher": [],
            "detail": "stop release db cluster"
        },

        // General utilities
        {
            "label": "format patch",
            "type": "shell",
            "command": "git format-patch -o \"${workspaceFolder}\" -${input:formatPatchNumber} -v ${input:formatPatchVersion}",
            "problemMatcher": [],
            "detail": "generate patches from the topmost <n> commits"
        },
        {
            "label": "perf record Release",
            "type": "shell",
            "command": "perf record -o \"${workspaceFolder}/Release/perf.data\" -p `ps aux | grep \"postgres postgres\" | grep -v grep | awk '{print $2}'` --call-graph dwarf sleep 10",
            "problemMatcher": [],
            "detail": "perf record"
        },
        {
            "label": "perf report Release",
            "type": "shell",
            "command": "perf report -i \"${workspaceFolder}/Release/perf.data\" --stdio --call-graph",
            "problemMatcher": [],
            "detail": "perf report"
        },
        {
            "label": "generate flamegraph Release",
            "type": "shell",
            "command": "flamegraph_dir=\"$HOME/freedom/tools/FlameGraph\"; if [ -d /opt/freedom/tools/FlameGraph ]; then flamegraph_dir=/opt/freedom/tools/FlameGraph; fi; timestamp=\"$(date +%Y%m%d%H%M%S)\" && perf script -i \"${workspaceFolder}/Release/perf.data\" | \"$flamegraph_dir/stackcollapse-perf.pl\" | \"$flamegraph_dir/flamegraph.pl\" > \"${workspaceFolder}/Release/perf_$timestamp.svg\"",
            "problemMatcher": [],
            "detail": "generate flamegraph"
        }
    ],
    "inputs": [
        {
            "id": "formatPatchNumber",
            "description": "patches from the topmost <n> commits",
            "type": "promptString",
            "default": "1"
        },
        {
            "id": "formatPatchVersion",
            "description": "<n>-th iteration of the topic",
            "type": "promptString",
            "default": "1"
        },
        {
            "id": "patchFile",
            "description": "Which patch file to apply?",
            "type": "promptString",
            "default": "*"
        }
    ]
}
